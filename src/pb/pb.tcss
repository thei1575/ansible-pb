/* pb: run control for Ansible repositories */

Screen {
    background: #111820;
    color: #dce5e8;
}

/* --- top status strip ------------------------------------------- */

#statusbar {
    dock: top;
    height: 1;
    padding: 0 1;
    background: #273544;
    color: #aeb9c2;
}

/* --- tabs ------------------------------------------------------- */

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
}

/* --- the two-pane split used by most tabs ----------------------- */

.split {
    height: 1fr;
}

.split > DataTable {
    width: 1fr;
    height: 1fr;
    border-right: solid #273544;
}

.detail {
    width: 52;
    min-width: 34;
    height: 1fr;
    padding: 1 2;
    background: #17212b;
}

.detail-body {
    width: 1fr;
    height: auto;
}

DataTable {
    background: #111820;
}

DataTable > .datatable--cursor {
    background: #c77b16;
    color: #111820;
    text-style: bold;
}

DataTable > .datatable--header {
    background: #273544;
    color: #e5a33e;
    text-style: bold;
}

/* --- run-options strip at the bottom of the Playbooks tab -------- */

#options {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: #273544;
    color: #dce5e8;
}

/* --- run screen -------------------------------------------------- */

#run-command {
    dock: top;
    height: 1;
    padding: 0 1;
    background: #273544;
    color: #e5a33e;
    text-style: bold;
}

#run-status {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: #273544;
}

#run-log {
    height: 1fr;
    background: #111820;
    scrollbar-size-vertical: 1;
}

/* --- modals ------------------------------------------------------ */

ModalScreen {
    align: center middle;
}

.dialog {
    width: 78;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: #17212b;
    border: round #c77b16;
}

.dialog-wide {
    width: 110;
    max-width: 95%;
    height: 80%;
    padding: 1 2;
    background: #17212b;
    border: round #c77b16;
}

.dialog-title {
    height: 1;
    color: #e5a33e;
    text-style: bold;
    margin-bottom: 1;
}

.dialog-hint {
    height: auto;
    color: #aeb9c2;
    margin-top: 1;
}

.dialog SelectionList, .dialog OptionList {
    height: auto;
    max-height: 18;
    border: none;
    background: #17212b;
}

/* --- the update prompt ------------------------------------------- */

/* Sized to its notes rather than to the screen: a one-line release should
   not open a dialog four fifths of the terminal tall. */
.dialog-update {
    width: 110;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #17212b;
    border: round #c77b16;
}

.dialog-update .viewer {
    height: auto;
    max-height: 22;
}

#update-command, #update-note {
    height: auto;
    margin-top: 1;
}

.viewer {
    height: 1fr;
    background: #111820;
    padding: 0 1;
}

Input {
    border: tall #273544;
    background: #111820;
}

Input:focus {
    border: tall #c77b16;
}

Footer {
    background: #273544;
}
